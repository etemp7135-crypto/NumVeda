{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.js"
    },
    {
      "source": "/love",
      "destination": "/love.html"
    },
    {
      "source": "/love/(.*)",
      "destination": "/love.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
