{
  "functions": {
    "server.js": {
      "includeFiles": "**"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/love",
      "dest": "/love.html"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/love/(.*)",
      "dest": "/love.html"
    },
    {
      "src": "/favicon.png",
      "dest": "/favicon.png"
    },
    {
      "src": "/og_banner.png",
      "dest": "/og_banner.png"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
